rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer';
      allow update: if (owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullname']))
        || admin();
      allow delete: if admin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /devotionals/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /orders/{id} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || admin();
      // Only an UNVERIFIED demo order request, never proof of payment or stock reservation.
      // Price and quantity values are client-supplied and must be checked before fulfilment.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'userId', 'orderNumber', 'items', 'subtotal', 'shipping', 'total',
          'shippingAddress', 'city', 'postalCode', 'phone', 'paymentMethod',
          'status', 'createdAt'
        ]);
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /prayer_requests/{id} {
      allow read, update, delete: if admin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'name', 'email', 'subject', 'prayer', 'isPrivate', 'submittedAt']);
    }

    match /newsletter_subscribers/{id} {
      allow read, update, delete: if admin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if owner(id)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['frequency', 'name', 'email', 'subscribedAt']);
    }
  }
}
